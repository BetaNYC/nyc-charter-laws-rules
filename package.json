{
  "name": "@betanyc/nyc-charter-laws-rules",
  "version": "0.8.0",
  "description": "MCP server for NYC Charter, Administrative Code, and Rules of the City of New York",
  "mcpName": "io.github.BetaNYC/nyc-charter-laws-rules",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-assistant",
    "nyc",
    "new-york-city",
    "civic-tech",
    "open-data",
    "open-government",
    "betanyc",
    "nyc-charter",
    "administrative-code",
    "municipal-law",
    "legal",
    "rules"
  ],
  "license": "MIT",
  "author": "BetaNYC",
  "homepage": "https://github.com/BetaNYC/nyc-charter-laws-rules",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetaNYC/nyc-charter-laws-rules.git"
  },
  "bugs": {
    "url": "https://github.com/BetaNYC/nyc-charter-laws-rules/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nyc-charter-laws-rules": "dist/index.js"
  },
  "files": [
    "dist",
    "data/index/json",
    "WHATS-CHANGED.md",
    "DATA-SOURCES.json",
    "data.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "fetch-data": "node scripts/fetch-data.js",
    "build-index": "node scripts/build-index.js",
    "audit:coverage": "node scripts/audit-coverage.js",
    "update-changelog": "node scripts/update-changelog.js",
    "build-site": "node scripts/build-site.js",
    "serve-site": "node scripts/serve-site.js",
    "alt:inventory": "node scripts/alt-text.js inventory",
    "alt:draft": "node scripts/alt-text.js draft",
    "alt:review": "node scripts/alt-text.js review",
    "alt:build-static": "node scripts/alt-text.js build-static",
    "alt:images": "node scripts/alt-text.js images",
    "source-errors:images": "node scripts/source-errors-images.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "test:diff": "node --test test/diff/differential.mjs",
    "eval": "npm run build && node eval/run.mjs",
    "test:site": "node --test --test-force-exit test/site/*.test.mjs",
    "pretest:site-data": "npm run build",
    "test:site-data": "node --test test/site-data/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@nysds/components": "^1.23.2",
    "@types/node": "^22.0.0",
    "adm-zip": "^0.5.17",
    "fast-xml-parser": "^5.8.0",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
