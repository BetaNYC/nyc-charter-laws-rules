{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BetaNYC DATA-SOURCES.json",
  "description": "BetaNYC DATA-SOURCES.json: where a repo's data comes from. Standard: platform/system/about-data-standard.md in BetaNYC's workspace. Cross-field rules (unique ids, changes, freshness fields, terms, coverage order, published files) are checked by whats_changed.py about-data check and the TS reader, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "Optional pointer to this schema; ignored by the readers.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 5000,
      "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
    },
    "format": {
      "description": "Format and version of this file. Always betanyc-data-sources/1.",
      "const": "betanyc-data-sources/1"
    },
    "server": {
      "description": "The repo this file describes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The server or site name, e.g. nyc-311-mcp (the name passed to new Server()).",
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        },
        "title": {
          "description": "A plain-words title, e.g. NYC 311 MCP server.",
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        },
        "description": {
          "description": "One or two sentences on what it is and does.",
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        },
        "kind": {
          "description": "mcp for an MCP server (gets a DCAT DataService), site for a website.",
          "type": "string",
          "enum": [
            "mcp",
            "site"
          ]
        },
        "repository": {
          "description": "https://github.com/<owner>/<repo>",
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "homepage": {
          "description": "The public site, if there is one.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
          "not": {
            "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
          }
        },
        "documentation_url": {
          "description": "Where the tools are documented (default: the repo README).",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
          "not": {
            "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
          }
        },
        "endpoint_urls": {
          "description": "Hosted service endpoints only (e.g. an HTTP MCP URL); each becomes a DCAT DataService endpointURL. Leave empty for a stdio server run with npx; never an npm or GitHub page.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
            "not": {
              "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
            }
          }
        },
        "whats_changed_url": {
          "description": "The site's What's changed page, when there is one (default: WHATS-CHANGED.md on GitHub). Must match pageUrl in the server's config.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
          "not": {
            "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
          }
        },
        "license": {
          "description": "The license of the code.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
              "not": {
                "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
              }
            }
          },
          "required": [
            "name",
            "url"
          ]
        },
        "package_url": {
          "description": "Where the server is obtained, e.g. its npm package page. Becomes the catalog's homepage when there is no site.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
          "not": {
            "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
          }
        },
        "contact_email": {
          "description": "BetaNYC's monitored address for questions about this server (the DCAT contactPoint), plain, without mailto:. Until Noel names it, every file uses contact-not-yet-named@example.invalid, which about-data check --release refuses.",
          "type": "string",
          "pattern": "^(?![Mm][Aa][Ii][Ll][Tt][Oo]:)[A-Za-z0-9_~!$&'()*+,;=:.-]+@[A-Za-z0-9_.-]+\\.[A-Za-z0-9_.-]+$"
        },
        "keywords": {
          "description": "Keywords for the catalogs.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
          }
        }
      },
      "required": [
        "name",
        "title",
        "description",
        "kind",
        "repository",
        "license",
        "contact_email"
      ]
    },
    "sources": {
      "description": "One entry per kind of data. Every tool must appear under at least one source.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The topic name for about_data: lowercase letters, digits, single hyphens. 'all' is reserved.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "title": {
            "description": "What this kind of data is, in a few words.",
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
          },
          "what": {
            "description": "What the data contains, in a sentence or two.",
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
          },
          "source_name": {
            "description": "The source's name as its publisher gives it.",
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
          },
          "publisher": {
            "description": "Who publishes the source: the City or State agency for official data. BetaNYC's own output is derived from it; the publisher never changes to BetaNYC.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
                "not": {
                  "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
                }
              }
            },
            "required": [
              "name"
            ]
          },
          "source_url": {
            "description": "The source's own page or API.",
            "type": "string",
            "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
            "not": {
              "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
            }
          },
          "official": {
            "description": "true when the data is an official record as its publisher released it; false for BetaNYC's curation (hand-checked facts no official source publishes in one place).",
            "type": "boolean"
          },
          "how_gathered": {
            "description": "How the data reaches this server.",
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
          },
          "changes": {
            "description": "Raw, or changed by BetaNYC, and how.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "changed": {
                "description": "false when the server passes the data on as published.",
                "type": "boolean"
              },
              "steps": {
                "description": "What BetaNYC did: cleaned, filtered (left records out), reshaped (format or structure, values unchanged), fields-removed (whole fields left out, such as ZIP codes; every value kept is as published), address-matched, merged, counted, curated (defined in the standard). Only reshaped and fields-removed keep \"Official record: yes\"; every other step makes the figures BetaNYC's.",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "cleaned",
                    "filtered",
                    "reshaped",
                    "fields-removed",
                    "address-matched",
                    "merged",
                    "counted",
                    "curated"
                  ]
                }
              },
              "detail": {
                "description": "The changes in plain words. Required when changed is true.",
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              }
            },
            "required": [
              "changed"
            ]
          },
          "verify_at": {
            "description": "Where a reader can check a figure at the official source.",
            "type": "string",
            "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
            "not": {
              "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
            }
          },
          "freshness": {
            "description": "How about_data learns how current this data is on a running server. Never a date typed here.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "description": "live: fetched when asked. file: read a field from a JSON file the data build writes. hook: the server reports it (an index, or a download saved on this machine; it may say not fetched yet). copied: text copied into the server's code on a date kept in code beside it, reported by a hook under key.",
                "type": "string",
                "enum": [
                  "live",
                  "file",
                  "hook",
                  "copied"
                ]
              },
              "path": {
                "description": "kind file: path to the JSON file, relative to the package root.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
              },
              "field": {
                "description": "kind file: the top-level field holding the date or time.",
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              },
              "key": {
                "description": "kind hook or copied: the key in the server's freshness hooks.",
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              }
            },
            "required": [
              "kind"
            ]
          },
          "update_frequency": {
            "description": "How often the source updates, as an ISO 19115 code (the DCAT-US 3.0 accrualPeriodicity list).",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "continual",
              "daily",
              "weekly",
              "fortnightly",
              "monthly",
              "quarterly",
              "biannually",
              "annually",
              "asNeeded",
              "irregular",
              "notPlanned",
              "unknown"
            ]
          },
          "coverage": {
            "description": "What the data on this server covers.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "description": "First date covered, YYYY-MM-DD, or null.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "end": {
                "description": "Last date covered, or null when it is ongoing.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              },
              "geography": {
                "description": "The place covered, e.g. New York City, by community district.",
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              },
              "known_gaps": {
                "description": "What is missing, in plain words.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 5000,
                  "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
                }
              }
            },
            "required": [
              "geography"
            ]
          },
          "terms": {
            "description": "Terms of use. Give at least one of license_name, license_url or terms_url.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "license_name": {
                "description": "The license's name, or 'None stated by the publisher'.",
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              },
              "license_url": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
                "not": {
                  "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
                }
              },
              "terms_url": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
                "not": {
                  "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
                }
              },
              "credit_line": {
                "description": "The credit line a reuser should print.",
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              }
            },
            "required": []
          },
          "report_errors": {
            "description": "Where to report an error in the data itself. Errors in this server go to the repo's issues, added automatically.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "upstream_url": {
                "description": "The publisher's page or form for reporting a data error. A BetaNYC URL (its repo issues or beta.nyc) is worded as reporting to BetaNYC.",
                "type": "string",
                "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
                "not": {
                  "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
                }
              },
              "upstream_email": {
                "description": "The address for data errors at upstream_url (the publisher's, or upstream_name's when given), when one is published.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?![Mm][Aa][Ii][Ll][Tt][Oo]:)[A-Za-z0-9_~!$&'()*+,;=:.-]+@[A-Za-z0-9_.-]+\\.[A-Za-z0-9_.-]+$"
              },
              "upstream_name": {
                "description": "Who handles reports at upstream_url when that is not the publisher, for example a city's open data team that runs the error form. Leave it out when the publisher handles them. Ignored for a BetaNYC route. From 1.3.7.",
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              }
            },
            "required": [
              "upstream_url"
            ]
          },
          "tools": {
            "description": "The tools that answer from this source.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          },
          "caveats": {
            "description": "What a reader should know before using a number.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
            }
          },
          "corrections": {
            "description": "Anchors of WHATS-CHANGED.md entries tagged Correction that touched this source.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,200}$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "what",
          "source_name",
          "publisher",
          "source_url",
          "official",
          "how_gathered",
          "changes",
          "verify_at",
          "freshness",
          "coverage",
          "terms",
          "report_errors"
        ]
      },
      "minItems": 1
    },
    "published_data": {
      "description": "Only for data files BetaNYC itself publishes. Produces croissant.json and a BetaNYC Dataset in data.json.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        },
        "url": {
          "description": "The page about the published data.",
          "type": "string",
          "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
          "not": {
            "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
          }
        },
        "license": {
          "description": "The license BetaNYC publishes the files under.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
              "not": {
                "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
              }
            }
          },
          "required": [
            "name",
            "url"
          ]
        },
        "date_published": {
          "description": "First publication date, YYYY-MM-DD.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        },
        "cite_as": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
        },
        "live": {
          "description": "true when the files are rebuilt in place (Croissant isLiveDataset); then no checksum is given.",
          "type": "boolean"
        },
        "files": {
          "description": "One entry per file.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
              },
              "content_url": {
                "type": "string",
                "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$",
                "not": {
                  "pattern": "^https?://[^/?#]*(?:/[^?#]*)?/(?:\\.|%2[eE]){1,2}(?:/|[?#]|$)"
                }
              },
              "encoding_format": {
                "description": "Media type, e.g. text/csv.",
                "type": "string",
                "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
              },
              "sha256": {
                "description": "Required when live is false.",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "derived_from": {
                "description": "Source ids this file is built from.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 64
                },
                "minItems": 1
              },
              "fields": {
                "description": "The file's columns (a Croissant RecordSet).",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000,
                      "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000,
                      "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
                    },
                    "data_type": {
                      "description": "A Croissant 1.1 atomic type, written without sc:.",
                      "type": "string",
                      "enum": [
                        "Boolean",
                        "Date",
                        "Time",
                        "DateTime",
                        "Float",
                        "Integer",
                        "Text"
                      ]
                    },
                    "column": {
                      "description": "CSV column name. Give exactly one of column or json_path.",
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1,
                      "maxLength": 5000,
                      "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
                    },
                    "json_path": {
                      "description": "JSONPath to the value, for JSON files.",
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1,
                      "maxLength": 5000,
                      "pattern": "^(?=[\\s\\S]*[^ \\t\\u00a0\\ufeff])[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
                    }
                  },
                  "required": [
                    "name",
                    "description",
                    "data_type"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "content_url",
              "encoding_format",
              "derived_from",
              "fields"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "description",
        "url",
        "license",
        "date_published",
        "live",
        "files"
      ]
    }
  },
  "required": [
    "format",
    "server",
    "sources"
  ]
}
